{
  "format_version": 1,
  "id": "mcaquests:rebuild_the_walls",
  "scope": { "scope": "village", "fallback_radius": 64 },
  "sponsor": { "professions": ["minecraft:mason"], "on_death": "transfer" },
  "title": { "text": "Rebuild the Walls" },
  "category": "infrastructure",
  "reputation": { "on_phase_complete": 2, "on_project_complete": 10 },
  "phases": [
    {
      "key": "gather_stone",
      "dialogue": {
        "offer": { "text": "The walls won't mend themselves. Donate stone brick and a few torches and we'll have the materials to close the breaches." },
        "in_progress": { "text": "More stone, more light — the masons are ready when the supplies are." }
      },
      "objectives": [
        { "type": "mcaquests:donate_item", "item": "minecraft:stone_bricks", "count": 96 },
        { "type": "mcaquests:donate_item", "item": "minecraft:torch", "count": 16 }
      ],
      "rewards": [
        { "reward": { "type": "mcaquests:xp", "amount": 30 }, "target": "contributors" }
      ]
    },
    {
      "key": "raise_the_wall",
      "dialogue": {
        "offer": { "text": "Now we build. Set the stone along the breaches — sixteen blocks and the wall stands whole again." },
        "in_progress": { "text": "Lay them true and tight. A wall with gaps is no wall at all." }
      },
      "objectives": [
        { "type": "mcaquests:project_place_block", "block": "minecraft:stone_bricks", "count": 16 }
      ],
      "rewards": [
        { "reward": { "type": "mcaquests:hearts_with_participants", "amount": 10 }, "target": "all_participants" },
        { "reward": { "type": "mcaquests:item", "item": "minecraft:emerald", "count": 4 }, "target": "top_contributor" },
        { "reward": { "type": "mcaquests:village_reputation", "amount": 5 }, "target": "sponsor_village" }
      ]
    }
  ]
