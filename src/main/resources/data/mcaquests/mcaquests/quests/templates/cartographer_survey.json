      }
    ],
    "rewards": [
      {
        "type": "mcaquests:currency"
      },
      {
        "type": "mcaquests:xp",
        "amount": 20
      },
      {
        "type": "mcaquests:hearts",
        "amount": 4
      }
    ]
  }
