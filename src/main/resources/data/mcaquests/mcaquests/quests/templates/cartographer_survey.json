    ]
  },
  "dialogue": {
    "offer": {
      "translate": "mcaquests.quest.template_cartographer_survey.dialogue.offer",
      "with": [
        "{place_name}"
      ]
    },
    "accept": {
      "translate": "mcaquests.quest.template_cartographer_survey.dialogue.accept"
    },
    "decline": {
      "translate": "mcaquests.quest.template_cartographer_survey.dialogue.decline"
    },
    "in_progress": {
      "translate": "mcaquests.quest.template_cartographer_survey.dialogue.in_progress",
      "with": [
        "{place_name}"
      ]
    },
    "ready": {
      "translate": "mcaquests.quest.template_cartographer_survey.dialogue.ready",
      "with": [
        "{place_name}"
      ]
    },
    "complete": {
      "translate": "mcaquests.quest.template_cartographer_survey.dialogue.complete"
    }
  },
  "template": {
    "variables": {
      "place": {
        "kind": "biome",
        "ids": [
          "minecraft:desert",
          "minecraft:savanna",
          "minecraft:jungle",
          "minecraft:taiga",
          "minecraft:badlands",
          "minecraft:snowy_plains"
