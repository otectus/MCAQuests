{
  "format_version": 1,
  "id": "mcaquests:template_fisherman_catch",
  "weight": 14,
  "category": "gathering",
  "repeat": { "type": "cooldown", "cooldown_ticks": 24000 },
  "giver": { "professions": ["minecraft:fisherman"], "adult_only": true },
  "title": { "text": "A Good Haul: {catch_name}" },
  "dialogue": {
    "offer": { "text": "The smoker's cold and the nets are empty. Hook me {count} {catch_name} and we'll call it square." },
    "accept": { "text": "Cast where the water runs deep. Patience pulls the line." },
    "decline": { "text": "Bah. The fish can keep their secrets a while longer." },
    "in_progress": { "text": "Any {catch_name} on your line yet?" },
    "ready": { "text": "{count} {catch_name}, fresh off the hook! The smoker thanks you." },
    "complete": { "text": "Now that's a haul worth bragging about. Here's your share." }
  },
  "template": {
    "variables": {
      "catch": { "kind": "item", "tags": ["minecraft:fishes"] },
      "count": { "kind": "int", "min": 1, "max": 3 }
    },
    "objectives": [
      { "type": "mcaquests:fish_item", "item": "{catch}", "count": "{count}" }
    ],
    "rewards": [
      { "type": "mcaquests:item", "item": "minecraft:emerald", "count": 2 },
      { "type": "mcaquests:xp", "amount": 12 },
      { "type": "mcaquests:hearts", "amount": 10 }
    ]
  }
}
